		sourceColumn: mapping_status
		summarizeBy: none

	column source_file
		dataType: string
		sourceColumn: source_file
		summarizeBy: none

	partition Earthquakes = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents("LOCAL_PATH_REQUIRES_SETUP"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"public_id", type text}, {"event_type", type text}, {"origin_utc", type text}, {"modified_utc", type text}, {"longitude", type number}, {"latitude", type number}, {"magnitude", type number}, {"depth_km", type number}, {"magnitude_type", type text}, {"depth_type", type text}, {"evaluation_method", type text}, {"evaluation_status", type text}, {"evaluation_mode", type text}, {"earth_model", type text}, {"used_phase_count", type text}, {"used_station_count", type text}, {"magnitude_station_count", type text}, {"minimum_distance", type text}, {"azimuthal_gap", type text}, {"origin_error", type text}, {"magnitude_uncertainty", type text}, {"event_year", type number}, {"event_month", type text}, {"region_code", type text}, {"mapping_status", type text}, {"source_file", type text}}, "en-US")
			in Typed
