table Earthquakes

	measure 'Events' = COALESCE(COUNTROWS(Earthquakes), 0)
		formatString: #,0

	measure 'M4 Events' = COALESCE(CALCULATE(COUNTROWS(Earthquakes), Earthquakes[magnitude] >= 4), 0)
		formatString: #,0

	measure 'Shallow M4 Events' = COALESCE(CALCULATE(COUNTROWS(Earthquakes), Earthquakes[magnitude] >= 4, Earthquakes[depth_km] <= 40), 0)
		formatString: #,0

	measure 'Business Locations 2025' = CALCULATE(SUM(Business[geographic_units]), Business[reference_year] = 2025)
		formatString: #,0

	measure 'Regional Employees 2025' = CALCULATE(SUM(Business[employees]), Business[reference_year] = 2025)
		formatString: #,0

	measure 'M4 Depth 70' = COALESCE(CALCULATE(COUNTROWS(Earthquakes), Earthquakes[magnitude] >= 4, Earthquakes[depth_km] <= 70), 0)
		formatString: #,0

	measure 'Monthly M4' = COALESCE(SUM(Monthly[m4_events]), 0)
		formatString: #,0

	measure 'Monthly Shallow M4' = COALESCE(SUM(Monthly[shallow_m4_events]), 0)
		formatString: #,0

	column public_id
		dataType: string
		sourceColumn: public_id
		summarizeBy: none

	column event_type
		dataType: string
		sourceColumn: event_type
		summarizeBy: none

	column origin_utc
		dataType: string
		sourceColumn: origin_utc
		summarizeBy: none

	column modified_utc
		dataType: string
		sourceColumn: modified_utc
		summarizeBy: none

	column longitude
		dataType: double
		sourceColumn: longitude
		summarizeBy: none

	column latitude
		dataType: double
		sourceColumn: latitude
		summarizeBy: none

	column magnitude
		dataType: double
		sourceColumn: magnitude
		summarizeBy: none

	column depth_km
		dataType: double
		sourceColumn: depth_km
		summarizeBy: none

	column magnitude_type
		dataType: string
		sourceColumn: magnitude_type
		summarizeBy: none

	column depth_type
		dataType: string
		sourceColumn: depth_type
		summarizeBy: none

	column evaluation_method
		dataType: string
		sourceColumn: evaluation_method
		summarizeBy: none

	column evaluation_status
		dataType: string
		sourceColumn: evaluation_status
		summarizeBy: none

	column evaluation_mode
		dataType: string
		sourceColumn: evaluation_mode
		summarizeBy: none

	column earth_model
		dataType: string
		sourceColumn: earth_model
		summarizeBy: none

	column used_phase_count
		dataType: string
		sourceColumn: used_phase_count
		summarizeBy: none

	column used_station_count
		dataType: string
		sourceColumn: used_station_count
		summarizeBy: none

	column magnitude_station_count
		dataType: string
		sourceColumn: magnitude_station_count
		summarizeBy: none

	column minimum_distance
		dataType: string
		sourceColumn: minimum_distance
		summarizeBy: none

	column azimuthal_gap
		dataType: string
		sourceColumn: azimuthal_gap
		summarizeBy: none

	column origin_error
		dataType: string
		sourceColumn: origin_error
		summarizeBy: none

	column magnitude_uncertainty
		dataType: string
		sourceColumn: magnitude_uncertainty
		summarizeBy: none

	column event_year
		dataType: double
		sourceColumn: event_year
		summarizeBy: none

	column event_month
