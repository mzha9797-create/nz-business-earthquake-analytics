table Regions

	column region_code
		dataType: string
		sourceColumn: region_code
		summarizeBy: none

	column region_name
		dataType: string
		sourceColumn: region_name
		summarizeBy: none

	column land_area_km2
		dataType: double
		sourceColumn: land_area_km2
		summarizeBy: none

	column boundary_year
		dataType: string
		sourceColumn: boundary_year
		summarizeBy: none

	partition Regions = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents("LOCAL_PATH_REQUIRES_SETUP"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"region_code", type text}, {"region_name", type text}, {"land_area_km2", type number}, {"boundary_year", type text}}, "en-US")
			in Typed
